# Copy to .env and fill in deployment values. Never commit real credentials.
# Server-only login/signup/entity-switch JWT key: SAME value as Node server.
# Generate a NEW random value; never export it to web/mobile/bootstrap clients.
AUTHENTICATION_SECRET=replace-with-a-new-random-server-only-key
# Existing client payload/response signing and X-Nonce encryption key.
# Match Node JWT_SECRET, web VITE_SECRET_JWT_SECRET and mobile SECRET_KEY.
# Must be DIFFERENT from AUTHENTICATION_SECRET.
JWT_TOKEN=shared-client-payload-and-nonce-key

SECRET_KEY=replace-with-django-secret-key
DEBUG=False
DB_HOST=localhost
DB_NAME=chatterloop
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-me

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=replace-me
MONGODB_DB=chatterloop
MONGODB_CLUSTER_USER=replace-me
MONGODB_CLUSTER_PASS=replace-me
MONGODB_CLUSTER_HOST=replace-me

CASSANDRA_DB_HOST=replace-me
CASSANDRA_DB_NAME=chatterloop
CASSANDRA_DB_KEYSPACE=chatterloop
CASSANDRA_DB_PORT=29080
CASSANDRA_DB_USERNAME=replace-me
CASSANDRA_DB_PASSWORD=replace-me
CASSANDRA_DB_TOKEN=replace-me
CASSANDRA_DB_BUNDLE=secure-connect-chatterloop.zip
CASSANDRA_DB_ENDPOINT=replace-me

MAILINGSERVICE=https://your-mailing-service
EMAIL_HOST=your-mail-host
EMAIL_NOREPLY_USER=noreply@example.com
EMAIL_HOST_PASSWORD=replace-with-existing-noreply-mail-password
EMAIL_VERIFY_USER=verify@example.com
EMAIL_VERIFY_PASS=replace-with-existing-verification-mail-password
# Set both mail passwords explicitly so rotating JWT_TOKEN does not change them.
INTERNAL_SERVICE_SECRET=shared-secret-with-node-server
RABBITMQ_PROTOCOL=amqps
RABBITMQ_USER=replace-me
RABBITMQ_PASS=replace-me
RABBITMQ_HOST=replace-me
RABBITMQ_PORT=5671
RABBITMQ_VHOST=replace-me
